{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,14333;Database=BackgroundJobsLab;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True",
    "Hangfire": "Server=localhost,14333;Database=BackgroundJobsLab_Hangfire;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True"
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27018",
    "Database": "backgroundjobslab"
  },
  "AllowedHosts": "*"
}
